# ---- Backend Environment Variables ----

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/coop_gig_platform

# JWT Auth
JWT_SECRET=replace_with_a_long_random_secret

# Payment Gateway (Razorpay example — swap for Stripe if preferred)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Geo / Maps (for geo-matching, distance calc, address lookup)
GOOGLE_MAPS_API_KEY=your_maps_api_key

# Frontend (used by React build, must be prefixed REACT_APP_)
REACT_APP_API_BASE_URL=http://localhost:5000/api